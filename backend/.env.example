# Database configuration
DB_USER=<database-user>
DB_PASS=<database-password>
DATABASE_URL=postgresql://<database-user>:<database-password>@localhost:5432/sharemeet_db

# JWT configuration
JWT_SECRET=<replace-with-local-development-secret>
JWT_ACCESS_EXPIRES_IN=900s
JWT_REFRESH_EXPIRES_IN=604800s

# Google OAuth2 configuration (optional; leave empty until OAuth milestone)
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# Redis configuration (future; not required for auth foundation)
REDIS_HOST=localhost
REDIS_PORT=6379

# Frontend URL
FRONTEND_URL=http://localhost:3000
