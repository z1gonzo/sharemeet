# ShareMeet backend environment example
# Copy this file to .env for local backend work.

# Prisma reads this value when running migrations or starting the backend.
# Local PostgreSQL from ../db/docker-compose.yml is exposed on host port 5433.
DATABASE_URL="postgresql URL for ShareMeet Postgres on localhost port 5433"

# Runtime port. Hosts like Render/Railway/Fly usually inject this automatically.
PORT=3000

# Auth settings will be filled in when AuthModule is rebuilt.
JWT_ACCESS_EXPIRES_IN=900s
JWT_REFRESH_EXPIRES_IN=604800s

# Google OAuth is optional and belongs to a later milestone.
GOOGLE_CLIENT_ID=

# Redis is future infrastructure and is not required for auth foundation.
REDIS_HOST=localhost
REDIS_PORT=6379

# Frontend URL / allowed CORS origins.
# Local Vite default is http://localhost:5173.
# Production example: FRONTEND_URL=https://sharemeet.vercel.app
FRONTEND_URL=http://localhost:5173
# Optional comma-separated extra origins, e.g.
# CORS_ORIGINS=https://sharemeet.vercel.app,https://sharemeet-preview.vercel.app
CORS_ORIGINS=
